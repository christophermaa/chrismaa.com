---
import NeuralCanvas from './NeuralCanvas.astro';
import { site } from '@/data/site';
---

<section class="track" data-hero-track aria-labelledby="hero-title">
  <div class="stage" data-hero>
    <NeuralCanvas />
    <div class="scrim" aria-hidden="true"></div>

    <div class="container-x content">
      <p class="eyebrow">Neuroscience × Artificial Intelligence</p>
      <h1 id="hero-title" class="title">
        <span class="name">{site.name}</span>
        <span class="text-gradient">From neurons<br class="br" /> to networks.</span>
      </h1>
      <p class="tagline">{site.tagline}</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#projects">
          View projects
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a class="btn glass glass-hover" href={site.links.github} rel="noopener" target="_blank">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
          GitHub
        </a>
        <a class="btn glass glass-hover" href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>

    <div class="container-x content-2">
      <p class="eyebrow">Biological → artificial</p>
      <p class="h2">Same computation.<br /><span class="text-gradient">New substrate.</span></p>
      <p class="sub">Same rigour, new hardware: the problems I solved for neural signals carry over to other sensors.</p>
    </div>

    <aside class="hud glass glass-refract mono" aria-label="Simulation readout">
      <div class="hud-row"><span class="k">sim</span><span>LIF · spiking</span></div>
      <div class="hud-row"><span class="k">rate</span><span><span data-hud-rate>0.00</span> Hz/unit</span></div>
      <div class="hud-row"><span class="k">mode</span><span data-hud-mode class="mode">biological</span></div>
      <div class="hud-meter" aria-hidden="true"><span data-hud-bar></span></div>
      <p class="hud-hint">scroll to train · hover to stimulate</p>
    </aside>

    <a href="#about" class="scroll-cue mono" aria-label="Scroll to about section">
      <span class="line" aria-hidden="true"></span> scroll
    </a>
  </div>
</section>

<style>
  .track { position: relative; height: 175svh; }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 36rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    touch-action: pan-y;
  }
  @media (prefers-reduced-motion: reduce) {
    .track { height: auto; }
    .stage { position: relative; }
  }
  :global(html[data-motion='off']) .track { height: auto; }
  :global(html[data-motion='off']) .stage { position: relative; }

  .scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, oklch(0.13 0.02 265 / 0.92) 0%, oklch(0.13 0.02 265 / 0.6) 38%, transparent 62%),
      linear-gradient(0deg, var(--bg) 0%, transparent 22%);
  }
  @media (max-aspect-ratio: 1/1) {
    .scrim {
      background:
        radial-gradient(120% 60% at 30% 45%, oklch(0.13 0.02 265 / 0.85), transparent 75%),
        linear-gradient(0deg, var(--bg) 0%, transparent 18%);
    }
  }

  .content {
    position: relative;
    z-index: 1;
    pointer-events: none;
    padding-top: 4rem;
    opacity: calc(1 - var(--p, 0) * 1.4);
    transform: translateY(calc(var(--p, 0) * -40px));
  }
  .content :is(a, button) { pointer-events: auto; }
  .content-2 {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    pointer-events: none;
    opacity: clamp(0, calc((var(--p, 0) - 0.5) * 3.2), 1);
    transform: translateY(calc((1 - var(--p, 0)) * 30px));
  }
  .content-2 .h2 { font-size: var(--step-3); font-weight: 650; letter-spacing: -0.03em; line-height: 1.05; margin-top: 1rem; max-width: 22rem; }
  .content-2 .sub { color: var(--ink-muted); margin-top: 1rem; max-width: 22rem; }
  @media (max-aspect-ratio: 1/1) {
    .content-2 { justify-content: flex-start; padding-top: 22svh; }
  }
  .title { display: grid; gap: 0.6rem; margin-top: 1.25rem; }
  .name { font-size: var(--step-1); font-weight: 500; color: var(--ink-muted); letter-spacing: 0; }
  .title .text-gradient { font-size: var(--step-4); font-weight: 650; letter-spacing: -0.035em; line-height: 1; padding-bottom: 0.1em; }
  .br { display: none; }
  @media (min-width: 640px) { .br { display: inline; } }
  .tagline { max-width: 34rem; margin-top: 1.25rem; font-size: var(--step-1); color: var(--ink-muted); }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  .hud {
    position: absolute;
    z-index: 2;
    right: clamp(1rem, 3vw, 2.5rem);
    bottom: clamp(1rem, 4vh, 2.5rem);
    width: 15.5rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.72rem;
    color: var(--ink-muted);
    display: none;
  }
  @media (min-width: 900px) and (min-height: 640px) { .hud { display: block; } }
  .hud-row { display: flex; justify-content: space-between; padding-block: 0.15rem; }
  .k { color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.1em; }
  .mode { color: var(--synapse); }
  .hud-meter { height: 3px; margin-top: 0.6rem; border-radius: 3px; background: oklch(1 0 0 / 0.08); overflow: hidden; }
  .hud-meter span {
    display: block;
    height: 100%;
    transform-origin: left;
    transform: scaleX(0);
    background: linear-gradient(90deg, var(--synapse), var(--dendrite));
  }
  .hud-hint { margin-top: 0.55rem; color: var(--ink-faint); }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    translate: -50% 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
    opacity: calc(1 - var(--p, 0) * 4);
  }
  .scroll-cue .line {
    width: 1px;
    height: 2.25rem;
    background: linear-gradient(var(--synapse), transparent);
    animation: drip 2s var(--ease-out) infinite;
    transform-origin: top;
  }
  @keyframes drip {
    0% { transform: scaleY(0); opacity: 1; }
    70% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }
  @media (min-width: 900px) and (min-height: 640px) { .scroll-cue { left: 2.5rem; translate: 0; } }
</style>
