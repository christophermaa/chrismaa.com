---
import { site } from '@/data/site';
const links = [
  { href: '/#projects', label: 'Projects' },
  { href: '/#about', label: 'How I build' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#interests', label: 'Interests' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="nav-wrap no-print">
  <nav class="nav glass glass-refract" aria-label="Primary">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22">
          <circle cx="12" cy="12" r="3.2" fill="currentColor" />
          <path d="M12 8.8V3M12 15.2V21M8.8 12H3M15.2 12H21M9.7 9.7 5.5 5.5M14.3 14.3l4.2 4.2M14.3 9.7l4.2-4.2M9.7 14.3l-4.2 4.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.7" />
        </svg>
      </span>
      <span class="brand-name">{site.name}</span>
    </a>

    <ul class="links">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>

    <button type="button" class="palette-btn" data-open-palette aria-haspopup="dialog" aria-label="Open command palette">
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="m5 7 3 3-3 3M10 13h5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span class="hide-sm">Command</span>
      <kbd class="hide-sm" data-mod-key>⌘K</kbd>
    </button>
  </nav>
</header>

<style>
  .nav-wrap {
    position: fixed;
    inset: 0.75rem 0 auto;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 1rem;
    pointer-events: none;
  }
  .nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: min(100%, 64rem);
    white-space: nowrap;
    padding: 0.45rem 0.45rem 0.45rem 0.9rem;
    border-radius: 999px;
    --glass-tint: oklch(0.22 0.035 265 / 0.55);
  }
  .brand { display: flex; align-items: center; gap: 0.55rem; font-weight: 600; letter-spacing: -0.01em; margin-right: auto; }
  .brand-mark { color: var(--synapse); display: grid; place-items: center; }
  .brand:hover .brand-mark { color: var(--spike); }
  .links { display: none; list-style: none; margin: 0; padding: 0; gap: 0.15rem; }
  .links a {
    display: block;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    color: var(--ink-muted);
    font-size: 0.92rem;
    transition: color 0.2s, background-color 0.2s;
  }
  .links a:hover { color: var(--ink); background: oklch(1 0 0 / 0.07); }
  .palette-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    border: 1px solid oklch(1 0 0 / 0.12);
    background: oklch(1 0 0 / 0.06);
    color: var(--ink);
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
  }
  .palette-btn:hover { background: oklch(1 0 0 / 0.1); border-color: oklch(0.82 0.14 200 / 0.4); }
  .palette-btn svg { color: var(--synapse); }
  .hide-sm { display: none; }
  @media (min-width: 480px) { .hide-sm { display: inline; } }
  @media (min-width: 1080px) { .links { display: flex; } }
</style>
