---
/**
 * Hero background. Renders a static SVG snapshot of the network at build time
 * (no-JS, reduced-motion and pre-hydration state), then the canvas takes over.
 */
import { BUCKETS, buildGraph, type Graph } from '@/lib/neural-graph';

const graphs = [buildGraph(BUCKETS.landscape), buildGraph(BUCKETS.portrait)];

function curve(g: Graph, e: Graph['bio'][number]) {
  const a = g.nodes[e.from]!;
  const b = g.nodes[e.to]!;
  const mx = (a.bx + b.bx) / 2;
  const my = (a.by + b.by) / 2;
  const dx = b.bx - a.bx;
  const dy = b.by - a.by;
  const cx = mx - dy * e.bend;
  const cy = my + dx * e.bend;
  return `M${a.bx.toFixed(1)} ${a.by.toFixed(1)}Q${cx.toFixed(1)} ${cy.toFixed(1)} ${b.bx.toFixed(1)} ${b.by.toFixed(1)}`;
}
---

<div class="neural" aria-hidden="true">
  {
    graphs.map((g) => (
      <svg
        class={`fallback fallback-${g.bucket.id}`}
        viewBox={`0 0 ${g.bucket.w} ${g.bucket.h}`}
        preserveAspectRatio="xMidYMid slice"
      >
        <path d={g.bio.map((e) => curve(g, e)).join('')} fill="none" stroke="rgb(140 170 255 / 0.16)" stroke-width="1" />
        <g fill="rgb(63 212 230 / 0.75)">
          {g.nodes.map((n) => (
            <circle cx={n.bx.toFixed(1)} cy={n.by.toFixed(1)} r={n.r.toFixed(2)} />
          ))}
        </g>
      </svg>
    ))
  }
  <canvas data-neural></canvas>
</div>

<script>
  import { startNeuralCanvas } from '@/scripts/neural-canvas';
  const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-neural]');
  if (canvas) {
    const go = () => startNeuralCanvas(canvas);
    if ('requestIdleCallback' in window) requestIdleCallback(go, { timeout: 1200 });
    else setTimeout(go, 200);
  }
</script>

<style>
  .neural { position: absolute; inset: 0; overflow: hidden; }
  .neural svg,
  .neural canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fallback { transition: opacity 0.6s ease; }
  .fallback-portrait { display: none; }
  @media (max-aspect-ratio: 1/1) {
    .fallback-landscape { display: none; }
    .fallback-portrait { display: block; }
  }
  canvas { opacity: 0; transition: opacity 0.6s ease; }
  :global(.neural-live) canvas { opacity: 1; }
  :global(.neural-live) .fallback { opacity: 0; }
</style>
