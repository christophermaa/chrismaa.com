---
import { interests } from '@/data/cv';
const [lead, ...rest] = [...interests].sort((a, b) => Number(!!b.featured) - Number(!!a.featured));
---

<section id="interests" class="section" aria-labelledby="interests-title">
  <div class="container-x">
    <p class="eyebrow reveal">05 · Beyond the lab</p>
    <h2 id="interests-title" class="h-section reveal">Interests</h2>
    <p class="lede reveal">Where I'm heading next.</p>

    <div class="grid">
      {
        lead && (
          <article class="lead glass glass-hover reveal">
            <div class="lead-text">
              <p class="mono k">{lead.kicker}</p>
              <h3>{lead.title}</h3>
              <p class="body">{lead.body}</p>
              {lead.tags && (
                <ul class="tags" role="list">
                  {lead.tags.map((t) => (
                    <li class="tag">{t}</li>
                  ))}
                </ul>
              )}
            </div>
            <svg class="orbit" viewBox="0 0 240 240" aria-hidden="true">
              <defs>
                <radialGradient id="planet" cx="38%" cy="35%" r="70%">
                  <stop offset="0" stop-color="oklch(0.62 0.12 220)" />
                  <stop offset="0.6" stop-color="oklch(0.32 0.08 250)" />
                  <stop offset="1" stop-color="oklch(0.18 0.04 265)" />
                </radialGradient>
                <linearGradient id="swath" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="var(--synapse)" stop-opacity="0.55" />
                  <stop offset="1" stop-color="var(--synapse)" stop-opacity="0" />
                </linearGradient>
              </defs>
              <ellipse cx="120" cy="120" rx="104" ry="38" fill="none" stroke="oklch(1 0 0 / 0.14)" stroke-dasharray="2 5" transform="rotate(-18 120 120)" />
              <circle cx="120" cy="120" r="52" fill="url(#planet)" />
              <path d="M84 104 q18 -10 34 -2 t30 0 M78 126 q22 8 40 0 t36 4 M96 146 q14 6 28 0" fill="none" stroke="oklch(1 0 0 / 0.12)" stroke-width="1.2" stroke-linecap="round" />
              <g class="sat-orbit">
                <g transform="translate(224 120)">
                  <path class="beam" d="M0 0 L-62 -14 L-62 14 Z" fill="url(#swath)" transform="rotate(0)" />
                  <rect x="-5" y="-3" width="10" height="6" rx="1.5" fill="var(--ink)" />
                  <rect x="-3" y="-13" width="6" height="8" fill="var(--synapse)" opacity="0.8" />
                  <rect x="-3" y="5" width="6" height="8" fill="var(--synapse)" opacity="0.8" />
                </g>
              </g>
            </svg>
          </article>
        )
      }
      {
        rest.map((i) => (
          <article class="card glass reveal">
            <p class="mono k">{i.kicker}</p>
            <h3>{i.title}</h3>
            <p class="body">{i.body}</p>
            {i.tags && (
              <ul class="tags" role="list">
                {i.tags.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 1rem; margin-top: 2.5rem; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .grid { grid-template-columns: repeat(3, 1fr); } .lead { grid-column: 1 / -1; } }
  .lead, .card { padding: clamp(1.25rem, 3vw, 2rem); display: grid; gap: 0.75rem; align-content: start; }
  .lead { overflow: hidden; }
  @media (min-width: 760px) {
    .lead { grid-template-columns: 1fr 15rem; align-items: center; gap: 2rem; }
  }
  .k { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--synapse); }
  h3 { font-size: var(--step-1); font-weight: 600; }
  .lead h3 { font-size: var(--step-2); margin-top: 0.4rem; }
  .body { color: var(--ink-muted); }
  .lead .body { margin-top: 0.75rem; max-width: 40rem; }
  .tags { list-style: none; padding: 0; margin: 0.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .lead .tags { margin-top: 1.1rem; }
  .orbit { width: 100%; max-width: 15rem; justify-self: center; overflow: visible; }
  .sat-orbit { transform-origin: 120px 120px; }
  @media (prefers-reduced-motion: no-preference) {
    .sat-orbit { animation: orbit 18s linear infinite; }
    .beam { animation: ping 3s ease-in-out infinite; transform-box: fill-box; transform-origin: right center; }
  }
  :global(html[data-motion='off']) .sat-orbit,
  :global(html[data-motion='off']) .beam { animation: none; }
  @keyframes orbit { to { transform: rotate(360deg); } }
  @keyframes ping { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }
</style>
