  }
  .pillar { padding: clamp(1.25rem, 3vw, 1.75rem); display: grid; gap: 0.6rem; align-content: start; }
  .k { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--synapse); }
  h3 { font-size: var(--step-1); font-weight: 600; }
