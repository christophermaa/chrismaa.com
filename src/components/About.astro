  .next {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.35rem;
    border-radius: var(--radius-md);
  }
  .next-icon { color: var(--synapse); display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: oklch(0.82 0.14 200 / 0.1); }
  .next-text { display: grid; gap: 0.15rem; }
  .next-k { font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--spike); }
  .next-t { font-weight: 600; }
  .next-s { color: var(--ink-muted); font-size: 0.92rem; }
  .next-arrow { color: var(--ink-faint); transition: translate 0.3s var(--ease-out), color 0.2s; }
