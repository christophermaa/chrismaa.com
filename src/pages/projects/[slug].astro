---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<Base title={d.title} description={d.summary}>
  <article class="container-x wrap">
    <a href="/#projects" class="back mono">← all projects</a>
    <header class="head">
      <p class="eyebrow">{d.domain === 'neuro' ? 'Neuroscience' : d.domain === 'ai' ? 'Artificial intelligence' : 'Neuro × AI'}{d.year ? ` · ${d.year}` : ''}</p>
      <h1 class="title">{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>
      <div class="links">
        {d.repo && <a class="btn btn-primary" href={d.repo} target="_blank" rel="noopener">View code ↗</a>}
        {d.demo && <a class="btn glass glass-hover" href={d.demo} target="_blank" rel="noopener">Live demo ↗</a>}
      </div>
    </header>
    <div class="prose glass">
      <Content />
    </div>
  </article>
</Base>

<style>
  .wrap { padding-block: 8rem 5rem; max-width: 48rem; }
  .back { font-size: 0.8rem; color: var(--ink-faint); }
  .back:hover { color: var(--synapse); }
  .head { margin-top: 2rem; }
  .title { font-size: var(--step-4); font-weight: 650; margin-top: 0.75rem; letter-spacing: -0.035em; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.5rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .prose { margin-top: 3rem; padding: clamp(1.25rem, 4vw, 2.5rem); color: var(--ink-muted); }
  .prose :global(h2) { color: var(--ink); font-size: var(--step-2); margin: 2rem 0 0.75rem; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 1rem; }
  .prose :global(li) { margin-bottom: 0.35rem; }
  .prose :global(a) { color: var(--synapse); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(blockquote) { margin: 0 0 1.5rem; padding: 0.75rem 1rem; border-left: 2px solid var(--spike); background: oklch(1 0 0 / 0.03); border-radius: 0 0.5rem 0.5rem 0; }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.88em; padding: 0.1rem 0.35rem; border-radius: 4px; background: oklch(1 0 0 / 0.07); }
  .prose :global(pre) { overflow-x: auto; padding: 1rem; border-radius: 0.75rem; background: oklch(0.1 0.02 265) !important; }
</style>
