---
import Base from '@/layouts/Base.astro';
---

<Base title="Signal lost" noindex>
  <section class="lost container-x">
    <svg class="flat" viewBox="0 0 800 120" preserveAspectRatio="none" aria-hidden="true">
      <polyline points="0,60 260,60 280,20 295,100 310,45 325,60 800,60" fill="none" stroke="var(--synapse)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
    </svg>
    <p class="eyebrow">Error 404</p>
    <h1 class="title">Signal lost.</h1>
    <p class="lede">This page flatlined. The spike you were looking for doesn't exist, or it's been pruned.</p>
    <div class="ctas">
      <a class="btn btn-primary" href="/">Back to home</a>
      <button type="button" class="btn glass glass-hover" data-open-palette>Open command palette</button>
    </div>
  </section>
</Base>

<style>
  .lost { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding-block: 8rem 4rem; }
  .flat { width: 100%; height: 6rem; margin-bottom: 2.5rem; opacity: 0.8; }
  .title { font-size: var(--step-4); font-weight: 650; margin-top: 0.75rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .ctas button { font: inherit; color: inherit; border: 0; cursor: pointer; }
</style>
